# ===========================================================================
# InSight Platform — environment template
#
# Copy to .env and fill in.  .env is gitignored and must NEVER be committed.
#   PowerShell:  Copy-Item .env.example .env
# ===========================================================================

APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL + pgvector
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insight
POSTGRES_USER=insight
POSTGRES_PASSWORD=change-me-locally

# Separate INSERT-only role for the audit log, so application code
# cannot rewrite history even if compromised (INS-11).
POSTGRES_AUDIT_USER=insight_audit
POSTGRES_AUDIT_PASSWORD=change-me-locally

# ---------------------------------------------------------------------------
# Redis — cache and Streams backbone
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# SpiceDB — fine-grained document/meeting permissions (INS-10)
# ---------------------------------------------------------------------------
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_PRESHARED_KEY=generate-your-own-locally
SPICEDB_INSECURE=true

# ---------------------------------------------------------------------------
# Auth — short-lived access token, rotating refresh token (INS-6, INS-7)
# Generate:  openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---------------------------------------------------------------------------
# LLM gateway (INS-14)
# Model names live here, NEVER hardcoded in source. Development runs on
# local Ollama. Production routes inside the client tenancy (Bedrock /
# Azure OpenAI) per locked decision 2 — that is a config change, not a code
# change.
# ---------------------------------------------------------------------------
LITELLM_GENERATION_MODEL=ollama/llama3.1:8b
LITELLM_FALLBACK_MODEL=ollama/mistral:7b
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Embeddings (INS-21)
# The model name AND dimension are stamped on every stored vector so a
# mismatch is detectable instead of silently returning garbage.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# ---------------------------------------------------------------------------
# Cross-encoder reranking (INS-24) — CPU
# ---------------------------------------------------------------------------
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=5
RETRIEVE_TOP_K=50

# ---------------------------------------------------------------------------
# Langfuse — SELF-HOSTED ONLY (INS-17)
# The SaaS version would send board prompts outside the client tenancy and
# break locked decision 2. Keep this pointed at the local container.
# ---------------------------------------------------------------------------
LANGFUSE_HOST=http://localhost:3000

# Created in the Langfuse UI on first run, then pasted back here.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Required to start the Langfuse container. Generate both:
#   openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
LANGFUSE_SALT=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# DEFERRED — frontier-model certification of R1 gate criterion 3.
# Left blank during normal development. Populated only for the one
# certification run, once budget is allocated.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
